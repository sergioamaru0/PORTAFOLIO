# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore; nunca subas secretos al repositorio.
#
# OpenCode V2 no carga .env automáticamente: el MCP de GitHub lee
# el token de .secrets/github-mcp-token (también ignorado por git).

# GitHub MCP — token de acceso personal (fine-grained recomendado).
# Permisos mínimos: Metadata read, Contents read/write,
# Issues read/write, Pull requests read/write.
GITHUB_MCP_TOKEN=

# Netlify MCP — el token real vive en .secrets/netlify-mcp-token
# (servidor local @netlify/mcp con NETLIFY_PERSONAL_ACCESS_TOKEN).
NETLIFY_MCP_TOKEN=
