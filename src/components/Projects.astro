---
import { Image } from 'astro:assets';
import PhpIcon from "../assets/icons/PhpIcon.astro";
import TailwindIcon from '../assets/icons/TailwindIcon.astro';
import ProyectClima from '../assets/image/projectClima.jpeg';
import postquickbet from '../assets/image/photomovie.png';
import NextjsIcon from '../assets/icons/Nextjx.astro';
import Flutter from '../assets/icons/Flutter.astro'

const TAGS = {
    TAILWIND:{
        name:'Tailwind CSS',
        class:'bg-muted text-foreground',
        icon:TailwindIcon,
    },
    PHP:{
        name:'PHP',
        class:'bg-muted text-foreground',
        icon:PhpIcon,
    },
    nextJS:{
        name:'nextJS',
        class:'border border-border bg-surface text-muted-foreground',
        icon:NextjsIcon,
    },
    Flutter:{
        name:'Flutter',
        class:'border border-border bg-surface text-muted-foreground',
        icon:Flutter,
    }
} 
const PROJECTS =[
    {
        title:'CLIMA APP',
        description: 'La aplicación proporciona información meteorológica actualizada en tiempo '+
                    'real basada en la ubicación del usuario o en una ubicación seleccionada manualmente.',
        link:'#',
        github:'https://github.com/sergioamaru0/clima/blob/main/README.md',
        image:ProyectClima,
        alt:'Captura de la app del clima con la temperatura actual, el pronóstico por horas y la ubicación seleccionada',
        tags: [TAGS.TAILWIND,TAGS.Flutter],
    },
    {
        title:'QUICKBET',
        description: 'QuickBet Movies es una aplicación web moderna y responsiva para explorar y ver películas en streaming. Construida con Next.js y React, ofrece una interfaz elegante para navegar, buscar y disfrutar de películas.',
        link:'#',
        github:'https://github.com/sergioamaru0/prueba-next.js/tree/master',
        image:postquickbet,
        alt:'Captura de la app de películas con la rejilla de carteles y el buscador en la cabecera',
        tags: [TAGS.TAILWIND,TAGS.nextJS],
    }
]  
---
<div class="grid gap-8 lg:grid-cols-2">
{
PROJECTS.map(({image,alt,title,description,tags,github})=>(
    <article
    class="relative isolate flex min-w-0 max-w-full flex-col gap-4 rounded-lg border border-border bg-surface p-4 before:absolute before:inset-0 before:-z-10 before:translate-x-1 before:translate-y-1 before:rounded-lg before:border before:border-border before:bg-muted hover:[transform:perspective(800px)_rotateX(2deg)_rotateY(-2deg)] motion-reduce:transform-none">

        <Image
            src={image}
            alt={alt}
            class="aspect-video w-full rounded-lg object-cover"
            widths={[360, 720]}
            sizes="(min-width: 1024px) 320px, calc(100vw - 80px)"
            loading="lazy"
            decoding="async"
        />
        <h3 class="break-words text-2xl font-semibold text-foreground">{title}</h3>
        <p class="max-w-prose break-words text-base text-muted-foreground text-pretty">{description}</p>
        <ul class="flex flex-row flex-wrap gap-2">
            {
                tags.map((tag)=>(
                    <li>
                        <span
                            class={`inline-flex items-center gap-x-2 rounded-full px-3 py-1 text-xs font-medium ${tag.class}`}>
                            <tag.icon class="size-4" aria-hidden="true"/>
                            {tag.name}
                        </span>                       
                    </li>
                ))
            }
        </ul>
        <a
            href={github}
            class="inline-flex min-h-11 max-w-full items-center gap-x-2 self-start break-words rounded border border-border-strong bg-surface px-4 text-sm font-medium text-foreground hover:bg-muted">
            Ver proyecto de {title}
            <svg
                class="size-4"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 14 10"
            >
                <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M1 5h12m0 0L9 1m4 4L9 9"></path>
            </svg>
        </a>
    </article>
))

}
</div>
