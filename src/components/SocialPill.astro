---
/*
 * Píldora de enlace externo. Los estilos vienen de tokens (RF-11, RF-12) y el
 * área mínima de 44 px de `min-h-11` (RF-23). El foco lo pone el
 * `:focus-visible` global de `global.css` (RF-19).
 *
 * `target` y `rel` se emiten para enlaces externos: ni `download` (misma
 * origen) ni `mailto:` (gestor del sistema) deben abrir pestaña nueva.
 */
const { download, href, ...linkProps } = Astro.props;
const hasDownload = download !== undefined && download !== false;
const isMailto = typeof href === 'string' && href.startsWith('mailto:');
---

<a
    class="flex min-h-11 max-w-full min-w-0 items-center justify-center gap-x-3 break-all rounded-full border border-border-strong bg-muted px-3 text-foreground"
    {...linkProps}
    href={href}
    {...(hasDownload ? { download } : isMailto ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
>
    <slot />
</a>
