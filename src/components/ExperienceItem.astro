---
import type { ExperienceEntry } from "../data/experience.ts";

type Props = ExperienceEntry;

const { role, company, start, end, summary, certificate } = Astro.props;

const MONTH_LABEL: Record<string, string> = {
	"01": "enero",
	"02": "febrero",
	"03": "marzo",
	"04": "abril",
	"05": "mayo",
	"06": "junio",
	"07": "julio",
	"08": "agosto",
	"09": "septiembre",
	"10": "octubre",
	"11": "noviembre",
	"12": "diciembre",
};

function label(isoMonth: string): string {
	const [year, month] = isoMonth.split("-");
	return `${MONTH_LABEL[month] ?? month} ${year}`;
}

const actionClass =
	"inline-flex items-center min-h-11 px-4 text-sm font-medium rounded border border-border-strong bg-surface text-foreground hover:bg-muted";
---

<div class="md:grid md:grid-cols-3 md:gap-6">
	<div class="mb-1 min-w-0 md:mb-0">
		<time class="block font-mono text-sm text-muted-foreground" datetime={start}>
			{label(start)}
		</time>
		<span class="block font-mono text-sm text-muted-foreground" aria-hidden="true">
			-
		</span>
		<time class="block font-mono text-sm text-muted-foreground" datetime={end}>
			{label(end)}
		</time>
	</div>

	<div class="min-w-0 md:col-span-2">
		<h3 class="text-lg font-semibold text-foreground break-words">
			{role}
		</h3>
		<p class="text-base text-muted-foreground break-words">
			{company}
		</p>
		<p class="mb-4 max-w-prose text-base text-muted-foreground text-pretty break-words">
			{summary}
		</p>

		{
			certificate && (
				<div class="flex flex-wrap gap-2">
					<a
						href={certificate.url}
						target="_blank"
						rel="noopener noreferrer"
						class={actionClass}
					>
						Ver {certificate.label} de {company}
						<svg
							class="w-3 h-3 ms-2 rtl:rotate-180"
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 14 10"
						>
							<path
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M1 5h12m0 0L9 1m4 4L9 9"
							></path>
						</svg>
					</a>
					<a
						href={certificate.url}
						download={certificate.filename}
						class={actionClass}
					>
						Descargar {certificate.label} de {company}
					</a>
				</div>
			)
		}
	</div>
</div>
